{"name":"Big–Small Demo (React single‑file app)","type":"code/react","content":"import React, { useEffect, useMemo, useRef, useState } from "react";\nimport { motion, AnimatePresence } from "framer-motion";\nimport { RefreshCw, History, Coins, Info, ShieldCheck } from "lucide-react";\n\n// --- Utility: fair RNG using Web Crypto when available ---\nfunction fairRandomInt(min: number, max: number) {\n  const range = max - min + 1;\n  if (typeof window !== "undefined" && window.crypto?.getRandomValues) {\n    // Rejection-sampling to avoid modulo bias\n    const maxUint32 = 0xffffffff;\n    const limit = Math.floor(maxUint32 / range) * range;\n    const buf = new Uint32Array(1);\n    let x = 0;\n    do {\n      window.crypto.getRandomValues(buf);\n      x = buf[0];\n    } while (x >= limit);\n    return min + (x % range);\n  }\n  // Fallback\n  return Math.floor(Math.random() * range) + min;\n}\n\n// Types\ntype Guess = "BIG" | "SMALL";\n\ntype Round = {\n  id: number;\n  roll: number; // 1-100\n  outcome: Guess; // BIG if 51-100, SMALL if 1-50\n  userPick: Guess;\n  win: boolean;\n  bet: number;\n  balanceAfter: number;\n  ts: number;\n};\n\n// --- Main Component ---\nexport default function BigSmallDemo() {\n  const [balance, setBalance] = useState<number>(1000);\n  const [bet, setBet] = useState<number>(50);\n  const [busy, setBusy] = useState<boolean>(false);\n  const [lastRoll, setLastRoll] = useState<number | null>(null);\n  const [rounds, setRounds] = useState<Round[]>([]);\n  const [message, setMessage] = useState<string>("");\n  const nextId = useRef(1);\n\n  const probText = "50% SMALL (1–50) · 50% BIG (51–100)";\n\n  const stats = useMemo(() => {\n    const total = rounds.length;\n    const wins = rounds.filter((r) => r.win).length;\n    const winRate = total ? (wins / total) * 100 : 0;\n    const bigCount = rounds.filter((r) => r.outcome === "BIG").length;\n    const smallCount = total - bigCount;\n    const profit = balance - 1000;\n    return { total, wins, winRate, bigCount, smallCount, profit };\n  }, [rounds, balance]);\n\n  const canPlay = bet > 0 && bet <= balance && !busy;\n\n  function placeBet(pick: Guess) {\n    if (!canPlay) return;\n    setBusy(true);\n    setMessage("");\n    // Simulate a short reveal delay\n    setTimeout(() => {\n      const roll = fairRandomInt(1, 100);\n      const outcome: Guess = roll >= 51 ? "BIG" : "SMALL";\n      const win = outcome === pick;\n      const newBal = balance + (win ? bet : -bet);\n      const rec: Round = {\n        id: nextId.current++,\n        roll,\n        outcome,\n        userPick: pick,\n        win,\n        bet,\n        balanceAfter: newBal,\n        ts: Date.now(),\n      };\n      setLastRoll(roll);\n      setBalance(newBal);\n      setRounds((r) => [rec, ...r].slice(0, 100));\n      setBusy(false);\n      setMessage(win ? "You won!" : "You lost.");\n    }, 650);\n  }\n\n  function resetGame() {\n    setBalance(1000);\n    setBet(50);\n    setRounds([]);\n    setLastRoll(null);\n    setMessage("");\n    nextId.current = 1;\n  }\n\n  // Keyboard shortcuts\n  useEffect(() => {\n    const onKey = (e: KeyboardEvent) => {\n      if (busy) return;\n      if (e.key.toLowerCase() === "b") placeBet("BIG");\n      if (e.key.toLowerCase() === "s") placeBet("SMALL");\n    };\n    window.addEventListener("keydown", onKey);\n    return () => window.removeEventListener("keydown", onKey);\n  }, [busy]);\n\n  return (\n    <div className="min-h-screen w-full bg-gradient-to-b from-slate-900 via-slate-950 to-black text-slate-100 p-6 flex items-center justify-center">\n      <div className="w-full max-w-4xl">\n        {/* Header /}\n        <div className="mb-6 flex items-start justify-between gap-4">\n          <div>\n            <h1 className="text-3xl md:text-4xl font-bold tracking-tight">\n              Big–Small Probability Game (Demo)\n            </h1>\n            <p className="text-slate-400 mt-1 text-sm md:text-base">\n              For education & fun only — no real money, fair RNG, transparent odds. {probText}\n            </p>\n          </div>\n          <button\n            onClick={resetGame}\n            className="inline-flex items-center gap-2 rounded-2xl border border-slate-700 px-3 py-2 hover:bg-slate-800/50 transition shadow-sm"\n            title="Reset"\n          >\n            <RefreshCw className="w-4 h-4" />\n            Reset\n          </button>\n        </div>\n\n        {/ Top cards /}\n        <div className="grid md:grid-cols-3 gap-4 mb-6">\n          <div className="rounded-2xl bg-slate-900/60 border border-slate-800 p-4 shadow-lg backdrop-blur">\n            <div className="flex items-center justify-between">\n              <span className="text-slate-400 text-sm">Balance</span>\n              <Coins className="w-4 h-4" />\n            </div>\n            <div className="mt-2 text-3xl font-semibold">{balance}</div>\n            <div className={mt-1 text-xs ${stats.profit >= 0 ? \"text-emerald-400\" : \"text-rose-400\"}}>\n              P/L: {stats.profit >= 0 ? "+" : ""}{stats.profit}\n            </div>\n          </div>\n\n          <div className="rounded-2xl bg-slate-900/60 border border-slate-800 p-4 shadow-lg backdrop-blur">\n            <div className="flex items-center justify-between">\n              <span className="text-slate-400 text-sm">Rounds</span>\n              <History className="w-4 h-4" />\n            </div>\n            <div className="mt-2 text-3xl font-semibold">{stats.total}</div>\n            <div className="mt-1 text-xs text-slate-400">Win rate: {stats.winRate.toFixed(1)}%</div>\n          </div>\n\n          <div className="rounded-2xl bg-slate-900/60 border border-slate-800 p-4 shadow-lg backdrop-blur">\n            <div className="flex items-center justify-between">\n              <span className="text-slate-400 text-sm">Distribution</span>\n              <Info className="w-4 h-4" />\n            </div>\n            <div className="mt-2 text-3xl font-semibold">{stats.bigCount} / {stats.smallCount}</div>\n            <div className="mt-1 text-xs text-slate-400">BIG / SMALL observed</div>\n          </div>\n        </div>\n\n        {/ Game panel /}\n        <div className="rounded-3xl bg-slate-900/70 border border-slate-800 p-6 shadow-xl backdrop-blur">\n          {/ Controls /}\n          <div className="flex flex-col md:flex-row md:items-end gap-4">\n            <div className="flex-1">\n              <label className="text-slate-300 text-sm">Bet amount</label>\n              <div className="mt-2 flex items-center gap-2">\n                <input\n                  type="number"\n                  value={bet}\n                  min={1}\n                  max={balance}\n                  onChange={(e) => setBet(Math.max(1, Math.min(balance, Number(e.target.value))))}\n                  className="w-40 rounded-2xl bg-black/40 border border-slate-700 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-slate-600"\n                />\n                <div className="flex gap-2">\n                  {[10, 50, 100, 200].map((v) => (\n                    <button\n                      key={v}\n                      onClick={() => setBet(Math.min(balance, v))}\n                      className="rounded-2xl border border-slate-700 px-3 py-2 hover:bg-slate-800/60 text-sm"\n                    >\n                      {v}\n                    </button>\n                  ))}\n                  <button\n                    onClick={() => setBet(Math.min(balance, Math.floor(balance / 2)))}\n                    className="rounded-2xl border border-slate-700 px-3 py-2 hover:bg-slate-800/60 text-sm"\n                  >\n                    1/2\n                  </button>\n                  <button\n                    onClick={() => setBet(balance)}\n                    className="rounded-2xl border border-slate-700 px-3 py-2 hover:bg-slate-800/60 text-sm"\n                  >\n                    MAX\n                  </button>\n                </div>\n              </div>\n            </div>\n\n            <div className="flex-1">\n              <label className="text-slate-300 text-sm">Odds</label>\n              <div className="mt-2 text-slate-400 text-sm">{probText} · Payout: 1:1</div>\n            </div>\n\n            <div className="flex items-center gap-3">\n              <button\n                onClick={() => placeBet("SMALL")}\n                disabled={!canPlay}\n                className={rounded-2xl px-5 py-3 font-semibold shadow-lg transition border ${\n                  canPlay ? \"hover:scale-[1.02]\" : \"opacity-50 cursor-not-allowed\"\n                } bg-gradient-to-b from-slate-800 to-slate-900 border-slate-700}\n              >\n                SMALL (1–50)\n              </button>\n              <button\n                onClick={() => placeBet("BIG")}\n                disabled={!canPlay}\n                className={rounded-2xl px-5 py-3 font-semibold shadow-lg transition border ${\n                  canPlay ? \"hover:scale-[1.02]\" : \"opacity-50 cursor-not-allowed\"\n                } bg-gradient-to-b from-slate-800 to-slate-900 border-slate-700}\n              >\n                BIG (51–100)\n              </button>\n            </div>\n          </div>\n\n          {/ Result display /}\n          <div className="mt-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">\n            <div className="flex items-center gap-4">\n              <div className="w-24 h-24 rounded-3xl bg-black/50 border border-slate-800 flex items-center justify-center">\n                <AnimatePresence mode="popLayout">\n                  <motion.span\n                    key={lastRoll ?? "?"}\n                    initial={{ scale: 0.5, opacity: 0 }}\n                    animate={{ scale: 1, opacity: 1 }}\n                    exit={{ scale: 0.5, opacity: 0 }}\n                    transition={{ type: "spring", stiffness: 200, damping: 20 }}\n                    className="text-4xl font-extrabold"\n                  >\n                    {lastRoll ?? "?"}\n                  </motion.span>\n                </AnimatePresence>\n              </div>\n              <div>\n                <div className="text-sm text-slate-400">Last roll</div>\n                <div className="text-xl font-semibold">\n                  {lastRoll ? (lastRoll >= 51 ? "BIG" : "SMALL") : "—"}\n                </div>\n                <div className="text-sm mt-1">\n                  {message && (\n                    <span className={message.includes("won") ? "text-emerald-400" : "text-rose-400"}>\n                      {message}\n                    </span>\n                  )}\n                </div>\n              </div>\n            </div>\n\n            <div className="rounded-2xl bg-black/40 border border-slate-800 px-4 py-3 text-sm text-slate-300 flex items-center gap-2">\n              <ShieldCheck className="w-4 h-4" />\n              <span>\n                Responsible play: set limits, take breaks, and never use real money in this demo.\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/ History /}\n        <div className="mt-6 rounded-3xl bg-slate-900/70 border border-slate-800 p-6 shadow-xl backdrop-blur">\n          <div className="flex items-center justify-between mb-3">\n            <h2 className="text-lg font-semibold">Round History</h2>\n            <div className="text-sm text-slate-400">showing last {rounds.length} rounds</div>\n          </div>\n          <div className="overflow-auto max-h-80 rounded-xl border border-slate-800">\n            <table className="w-full text-sm">\n              <thead className="bg-black/40 sticky top-0">\n                <tr>\n                  <th className="text-left px-3 py-2">#</th>\n                  <th className="text-left px-3 py-2">Roll</th>\n                  <th className="text-left px-3 py-2">Outcome</th>\n                  <th className="text-left px-3 py-2">Your Pick</th>\n                  <th className="text-left px-3 py-2">Bet</th>\n                  <th className="text-left px-3 py-2">Result</th>\n                  <th className="text-left px-3 py-2">Balance</th>\n                  <th className="text-left px-3 py-2">Time</th>\n                </tr>\n              </thead>\n              <tbody>\n                {rounds.map((r) => (\n                  <tr key={r.id} className="odd:bg-slate-900/40">\n                    <td className="px-3 py-2">{r.id}</td>\n                    <td className="px-3 py-2 font-mono">{r.roll}</td>\n                    <td className="px-3 py-2">{r.outcome}</td>\n                    <td className="px-3 py-2">{r.userPick}</td>\n                    <td className="px-3 py-2">{r.bet}</td>\n                    <td className={px-3 py-2 ${r.win ? \"text-emerald-400\" : \"text-rose-400\"}}>{r.win ? "WIN" : "LOSE"}</td>\n                    <td className="px-3 py-2">{r.balanceAfter}</td>\n                    <td className="px-3 py-2 text-slate-400">{new Date(r.ts).toLocaleTimeString()}</td>\n                  </tr>\n                ))}\n                {rounds.length === 0 && (\n                  <tr>\n                    <td colSpan={8} className="px-3 py-6 text-center text-slate-400">\n                      No rounds yet. Place a bet to start.\n                    </td>\n                  </tr>\n                )}\n              </tbody>\n            </table>\n          </div>\n        </div>\n\n        {/ Footer note */}\n        <div className="mt-6 text-xs text-slate-500 leading-relaxed">\n          <p>\n            Disclaimer: This is a demo for educational purposes showing a fair 50/50 game with 1:1 payout. It is not a gambling product and does not support real-money payments. If you intend to build any real-money game, seek independent legal advice and implement strict KYC/AML, age gating, audit trails, and RNG certifications.\n          </p>\n        </div>\n      </div>\n    </div>\n  );\n}\n"}

